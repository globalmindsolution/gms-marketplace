{
  "group": "skill inventory and routing surface",
  "description": "All 32 shipped skills, checked deterministically. What a skill ROUTES on is its frontmatter — the `description` Claude matches against, and `disable-model-invocation`, which decides whether it may be auto-invoked at all. Both are packaged data, so both are assertable with no model and no cost.\n\nThis catches the failure the paid routing tier cannot: a skill that stops shipping, loses its description, or silently gains/loses its user-only flag. The behavioural half — does a real request actually route here — lives in dataset/routing.json and the evals/ tier.",
  "surface": "skills/*/SKILL.md",
  "covers": [
    "MAR-526"
  ],
  "profile": "bare",
  "cases": [
    {
      "id": "SKILL-analyze-ticket",
      "kind": "skill_manifest",
      "skill": "analyze-ticket",
      "title": "analyze-ticket: ships as a model-invocable skill with a routing description",
      "expect": {
        "present": true,
        "frontmatter": {
          "name": "analyze-ticket"
        },
        "frontmatter_nonempty": [
          "description"
        ],
        "frontmatter_absent": [
          "disable-model-invocation"
        ]
      }
    },
