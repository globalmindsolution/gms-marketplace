{
  "group": "12-filemap-guard",
  "description": "The file-map deny control as the PreToolUse hook actually runs it (dispatch.py file-map, payload on stdin): half one decides whether the guard applies and fails OPEN; half two decides whether THIS write is inside the declared map and fails CLOSED. Recorded because the first CLI mutation sweep found the deny exit code, the control-input refusals and the scope branches pinned by no case.",
  "surface": "PreToolUse file-map guard",
  "covers": [
    "MAR-529"
  ],
  "profile": "ticketed",
  "severity": "major",
  "cases": [
    {
      "id": "GUARD-001",
      "title": "no executor running: the guard does not apply and the write is allowed",
      "note": "Half one of the guard fails OPEN by design \u2014 a coordinator's or planner's write outside any map is not scope creep.",
      "files": [
        {
          "base": "ws",
          "path": "sessions/{{checkout_id}}.json",
          "json": {
            "ticket_id": "TKT-1"
          }
        }
      ],
      "invoke": {
        "script": "dispatch.py",
        "argv": [
          "file-map"
        ],
        "stdin": {
          "tool_name": "Write",
          "tool_input": {
            "file_path": "{{repo}}/src/login.py"
          },
          "cwd": "{{repo}}",
          "session_id": "sess-1"
        }
      },
      "expect": {
        "exit_code": 0
      }
    },
    {
      "id": "GUARD-002",
      "title": "an executor is running but no map was declared: allowed (the plan had no opinion)",
      "note": "A TRIVIAL/SMALL lane may run with no map at all; nothing declared means nothing to enforce.",
