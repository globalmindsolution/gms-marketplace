{
  "ticket_prefix": "MAR",
  "tracker": {
    "provider": "github",
    "github": {
      "owner": "globalmindsolution",
      "project_number": 1
    }
  },
  "release": {
    "version_locations": [
      ".claude-plugin/marketplace.json",
      "plugins/acs/.claude-plugin/plugin.json",
      "plugins/acs/.devin-plugin/plugin.json",
      ".devin-plugin/plugin.json"
    ],
    "extra_refs": [
      {
        "file": ".devin-plugin/plugin.json",
        "selector": {
          "pointer": "/requiredPlugins",
          "match": {
            "path": "plugins/acs"
          },
          "set": "ref"
        },
        "value_format": "v{version}"
      }
    ],
    "changelog_path": "plugins/acs/CHANGELOG.md",
    "tag_format": "v{version}",
    "base_branch": "main",
    "release_branch_format": "release/v{version}",
    "publish_driver": {
      "workflow": ".github/workflows/release.yml",
      "trigger_paths": [
        ".claude-plugin/marketplace.json"
      ]
    },
    "pre_release_gate": [
      "python3 -m unittest discover -s tests/evals -p check_*.py",
      "CLAUDE_CODE_DISABLE_AUTO_MEMORY=1 claude plugin eval plugins/acs --tag description --tag negative --tag control --ablation none --runs 10 -j 8 --threshold 0 --json plugins/acs/evals/results/release-gate-routing.json --trust-plugin --no-publish --max-cost-usd 250",
      "python3 scripts/eval_gate.py plugins/acs/evals/results/release-gate-routing.json --min-skill-rate 9/10 --min-suite-rate 99/100"
    ]
  },
  "tests": {
    "unit": {
      "command": "export ACS_COV_ROOT=$PWD COVERAGE_PROCESS_START=$PWD/.coveragerc; python3 -m coverage run -m unittest discover -s tests && python3 -m coverage combine && python3 -m coverage report --fail-under=$ACS_COVERAGE",
      "setup": "sudo apt-get update -qq && sudo apt-get install -y -qq libxml2-utils && python3 -m pip install --quiet \"coverage>=7.14.2\" jsonschema"
    }
  },
  "models": {
    "analyze-requirements": {
      "analyst": {
        "model": "claude-sonnet-5-5",
        "effort": "high"
      },
      "impact-analyst": {
        "model": "claude-sonnet-5-5",
        "effort": "high"
      },
      "impact-reviewer": {
        "model": "claude-opus-5-5",
        "effort": "high"
      }
    },
    "code": {
      "implementer": {
        "model": "claude-sonnet-5-5",
        "effort": "medium"
      }
    },
    "create-api-contract": {
      "contract-author": {
        "model": "claude-sonnet-5-5",
        "effort": "medium"
      },
      "contract-reviewer": {
        "model": "claude-opus-5-5",
        "effort": "high"
      }
    },
    "create-architecture": {
