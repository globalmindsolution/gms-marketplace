{
  "ticket_prefix": "MAR",
  "tracker": {
    "provider": "github",
    "github": {
      "owner": "globalmindsolution",
      "project_number": 1
    }
  },
  "models": {
    "planner": {
      "model": "claude-opus-5",
      "effort": "high"
    },
    "executor": {
      "model": "claude-opus-5",
      "effort": "high"
    },
    "verifier": {
      "model": "claude-opus-5",
      "effort": "high"
    }
  },
  "enforcement": {
    "checks": {
      "branch_name": true,
      "pr_title": true,
      "pr_description": true,
      "acs_label": true,
      "commit_message": true
    },
    "exempt_branches": [
      "release/*",
      "dependabot/*",
      "renovate/*"
    ],
    "exempt_label": "acs-exempt",
    "require_label": "ACS",
    "pr_description_sections": [
      "Summary",
      "Ticket",
      "Changes",
      "Test plan"
    ]
  },
  "formats": {
    "branch_name": "{type}/{ticket_id}-{slug}",
    "commit_message": "{ticket_id} {summary}",
    "pr_title": "[{ticket_ref}] {title}",
    "pr_description_template": "pr-default",
    "tickets": {
      "epic": {
        "title": "[EPIC] {title}",
        "description_template": "epic-default"
      },
      "story": {
        "title": "{title}",
        "description_template": "story-default"
      },
      "task": {
        "title": "{title}",
        "description_template": "task-default"
      }
    }
  },
  "release": {
    "version_locations": [
      ".claude-plugin/marketplace.json",
      "plugins/acs/.claude-plugin/plugin.json",
      "plugins/acs/.devin-plugin/plugin.json",
      ".devin-plugin/plugin.json"
    ],
    "extra_refs": [
      {
        "file": ".devin-plugin/plugin.json",
        "selector": {
          "pointer": "/requiredPlugins",
          "match": {
            "path": "plugins/acs"
          },
          "set": "ref"
        },
        "value_format": "v{version}"
      }
    ],
    "changelog_path": "plugins/acs/CHANGELOG.md",
    "tag_format": "v{version}",
    "base_branch": "main",
    "release_branch_format": "release/v{version}",
    "publish_driver": {
      "workflow": ".github/workflows/release.yml",
      "trigger_paths": [
        ".claude-plugin/marketplace.json"
      ]
    },
    "pre_release_gate": [
      "python3 -m unittest tests.acs.test_eval_cases",
      "claude plugin eval plugins/acs --tag routing --ablation none --trust-plugin --no-publish --max-cost-usd 20"
    ]
  },
  "tests": {
    "setup": "sudo apt-get update -qq && sudo apt-get install -y -qq libxml2-utils && python3 -m pip install --quiet \"coverage>=7.14.2\" jsonschema",
    "command": "export ACS_COV_ROOT=$PWD COVERAGE_PROCESS_START=$PWD/.coveragerc; python3 -m coverage run -m unittest discover -s tests && python3 -m coverage combine && python3 -m coverage report --fail-under=$ACS_COVERAGE"
  }
}
