{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "acs state fragment for /acs:breakdown-ticket",
  "description": "What THIS skill records: the `states` keys it owns. The envelope is validated centrally by step-state.schema.json; this fragment is why adding a skill is a directory rather than an edit to a central schema (§4.4).",
  "type": "object",
  "properties": {
    "states": {
      "type": "object",
      "properties": {
        "ticket_id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "converted_from": {
          "type": [
            "string",
            "null"
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "minted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "design_status": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
