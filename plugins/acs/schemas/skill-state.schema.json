{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/globalmindsolution/gms-marketplace/plugins/acs/schemas/skill-state.schema.json",
  "title": "acs <skill>-state.json",
  "description": "Per-skill state file in the ticket partition. The append-only `runs` array is the single source of truth for status: runs[-1].status is the current state; pre-hooks gate on it. Status, stop reason, and timestamps are never mirrored at top level. `skill` and `ticket_id` echo the filename/partition deliberately, so the file stays self-describing after archiving.",
  "type": "object",
  "required": ["skill", "ticket_id", "states", "findings", "errors", "runs"],
  "properties": {
    "skill": {
      "enum": ["code", "create-architecture", "create-design", "create-operations", "create-pr", "create-prd", "create-principles", "create-project", "create-quality", "create-requirements", "create-standards", "create-ticket", "docs-sync", "handoff", "initialize", "install-hooks", "merge-pr", "metrics", "release", "ship", "standardize-project", "test", "update", "usage", "create-spec"]
    },
    "ticket_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]+$"},
    "states": {
      "description": "The skill's current result data, consumed by the next skill (e.g. specs implemented, tests/coverage, verifier_passed, pr reference). Re-runs update it in place.",
      "type": "object"
    },
    "findings": {
      "description": "Anything worth passing on: review findings, user clarifications, gotchas. Latest run's view (replaced on re-run).",
      "type": "array"
    },
    "errors": {"type": "array"},
    "runs": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["started_at", "status"],
        "properties": {
          "started_at": {"type": "string", "format": "date-time"},
          "ended_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
          "session_id": {"oneOf": [{"type": "string"}, {"type": "null"}]},
          "transcript_path": {"oneOf": [{"type": "string"}, {"type": "null"}]},
          "checkout_id": {"oneOf": [{"type": "string"}, {"type": "null"}]},
          "tokens": {
            "type": "object",
            "properties": {
              "input": {"type": "integer", "minimum": 0},
              "output": {"type": "integer", "minimum": 0},
              "cache_creation": {"type": "integer", "minimum": 0},
              "cache_read": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          },
          "cost_usd": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
          "cost_basis": {
            "description": "Never fabricated, never zero-padded: absent/unavailable means no dollar figure is claimed.",
            "enum": ["measured", "apportioned", "unavailable"]
          },
          "cost_scope": {
            "description": "\"session_total\"/\"main_session_only\" on a measured or apportioned charge; cost_sampler.allocate_cost also reuses this field as the degraded reason (\"no_unconsumed_sample_in_window\"/\"cost_total_reset\") when cost_usd is null -- verified against the module's own real return values, not just the design's abstract two-value description.",
            "enum": ["session_total", "main_session_only", "no_unconsumed_sample_in_window", "cost_total_reset"]
          },
          "excluded_cost_usd": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
          "excluded_token_share": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "null"}]},
          "role_usage": {
            "description": "Per-role measured token/cost buckets (usage_reader/cost_sampler); a 'role': 'unattributed' entry counts toward the apportionment denominator but never receives a dollar share.",
            "type": "array",
            "items": {
              "type": "object",
              "required": ["role"],
              "properties": {
                "role": {"type": "string"},
                "input": {"type": "integer", "minimum": 0},
                "output": {"type": "integer", "minimum": 0},
                "cache_creation": {"type": "integer", "minimum": 0},
                "cache_read": {"type": "integer", "minimum": 0},
                "cost_usd": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
                "cost_basis": {"enum": ["measured", "apportioned", "unavailable"]}
              },
              "additionalProperties": true
            }
          },
          "model_usage": {
            "description": "Per-model measured token/cost buckets (usage_reader/cost_sampler), parallel to role_usage; cost_usd is the FULL charged delta apportioned by token share with no unattributed exclusion (D1.2 Option A), so its sum can exceed role_usage's attributed-only cost sum by excluded_cost_usd.",
            "type": "array",
            "items": {
              "type": "object",
              "required": ["model"],
              "properties": {
                "model": {"type": "string"},
                "input": {"type": "integer", "minimum": 0},
                "output": {"type": "integer", "minimum": 0},
                "cache_creation": {"type": "integer", "minimum": 0},
                "cache_read": {"type": "integer", "minimum": 0},
                "cost_usd": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
                "cost_basis": {"enum": ["measured", "apportioned", "unavailable"]}
              },
              "additionalProperties": true
            }
          },
          "status": {"enum": ["in_progress", "completed", "failed", "interrupted", "handed_off"]},
          "stop_reason": {"oneOf": [{"type": "string"}, {"type": "null"}]},
          "handoff_summary": {
            "description": "Required when status is handed_off: what is done, in flight, next actions, pending decisions.",
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
