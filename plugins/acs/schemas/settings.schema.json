    "tracker": {
      "description": "Ticket tracking backend. Tickets are always local-first; github adds two-way sync via the gh CLI (which manages its own auth - no secrets in settings).",
      "type": "object",
      "properties": {
        "provider": {
          "enum": [
            "local",
            "github"
          ],
          "default": "local"
        },
        "github": {
          "type": "object",
          "properties": {
            "owner": {
              "type": "string"
            },
            "project_number": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "design": {
      "description": "Which design documents this repo produces (ADR-0120), chosen at /acs:setup. HLD overview, tech-stack and cross-cutting are always written and are not listed here.",
      "type": "object",
      "properties": {
        "hld_types": {
          "description": "The high-level (docs/architecture/hld/) documents the Design skills write, by type id. Absent = the defaults; [] = none beyond the always-on ones.",
          "type": "array",
          "items": {
            "enum": [
              "c4-context",
              "c4-container",
              "c4-component",
              "data-model",
              "integration-map",
              "deployment",
              "project-structure",
              "data-flow",
              "capability-map"
            ]
          },
          "uniqueItems": true,
          "default": [
            "c4-context",
            "c4-container",
            "c4-component",
            "data-model",
            "integration-map",
            "deployment",
            "project-structure"
          ]
        },
        "lld_types": {
          "description": "The low-level (docs/architecture/lld/<feature>/) documents the Design skills write, by type id. Absent = the defaults; [] = none beyond the always-on ones.",
          "type": "array",
          "items": {
            "enum": [
              "api-contract",
              "logical-erd",
              "physical-schema",
              "sequence",
              "activity",
              "state",
              "component-detail",
              "class"
            ]
          },
          "uniqueItems": true,
          "default": [
            "api-contract",
            "logical-erd",
            "physical-schema",
            "sequence",
            "activity",
            "state"
          ]
        }
      },
      "additionalProperties": false
    },
    "release": {
      "description": "Settings-driven release-cut configuration for /acs:release (Decision 5, ADR 0054). Non-secret: file paths, JSON pointers, and format strings only \u2014 auth stays via gh, mirrors the tracker NFR. Absent = /acs:release cannot run for this repo (fails fast, no marketplace-hardcoded fallback); explicit null also disables it.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "version_locations",
            "changelog_path",
            "tag_format",
            "base_branch",
            "release_branch_format"
          ],
          "properties": {
            "version_locations": {
              "description": "Where the version string lives, bumped to the same value on every cut: a bare repo-relative path (version at '/version') or a {file, pointer} object.",
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "description": "Shorthand: a repo-relative file whose version is at '/version'. Same as {\"file\": <path>, \"pointer\": \"/version\"}."
                  },
                  {
                    "type": "object",
                    "required": [
                      "file",
                      "pointer"
                    ],
                    "properties": {
                      "file": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Repo-relative path, e.g. '.claude-plugin/marketplace.json'."
                      },
                      "pointer": {
                        "type": "string",
                        "minLength": 1,
                        "description": "RFC 6901 JSON pointer, e.g. '/version'."
                      },
                      "kind": {
                        "enum": [
                          "json-pointer"
                        ],
                        "default": "json-pointer",
                        "description": "Resolution strategy for this entry. Only json-pointer is supported this pass; an OPTIONAL forward-compat seam \u2014 a future PR may widen this enum (e.g. regex, line) as a strictly additive extension, never a schema rewrite."
                      }
                    },
                    "additionalProperties": true
                  }
                ]
              }
            },
            "extra_refs": {
              "description": "Non-version fields bumped alongside version_locations, e.g. a plugin catalog's per-entry source.ref. Optional \u2014 a repo with no such field (e.g. a plain package.json consumer) omits this or sets [].",
              "type": "array",
              "default": [],
              "items": {
                "type": "object",
                "required": [
                  "file",
                  "selector",
                  "value_format"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1
                  },
                  "selector": {
                    "description": "A name-match predicate against an array field, not a brittle array-index pointer \u2014 catalog/array order can change without breaking the bump.",
                    "type": "object",
                    "required": [
                      "pointer",
                      "match",
                      "set"
                    ],
                    "properties": {
                      "pointer": {
                        "type": "string",
                        "minLength": 1,
                        "description": "JSON pointer to the array to search, e.g. '/plugins'."
                      },
                      "match": {
                        "type": "object",
                        "minProperties": 1,
                        "description": "Key/value pairs the target array entry must match, e.g. {\"name\": \"acs\"}."
                      },
                      "set": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Slash-separated relative path to set on the matched entry, e.g. 'source/ref'."
                      }
                    },
                    "additionalProperties": true
                  },
                  "value_format": {
                    "type": "string",
                    "minLength": 1,
                    "description": "{version}-templated value written to the selector's target, e.g. 'v{version}'."
                  }
                },
                "additionalProperties": true
              }
            },
            "changelog_path": {
              "type": "string",
              "minLength": 1,
              "description": "Repo-relative path to the Keep-a-Changelog file the cut drafts/dates. Only the PATH is settings-driven \u2014 the section FORMAT stays a shared convention (R-A4), also depended on by publish_driver's own extractor."
            },
            "tag_format": {
              "type": "string",
              "minLength": 1,
              "description": "{version}-templated git tag name, e.g. 'v{version}'."
            },
            "base_branch": {
              "type": "string",
              "minLength": 1,
              "description": "Branch the 'since last tag' boundary and the release PR target, e.g. 'main'."
            },
            "release_branch_format": {
              "type": "string",
              "minLength": 1,
              "description": "{version}-templated release branch name, e.g. 'release/v{version}'. Should match one of enforcement.exempt_branches' globs (R-A5) or the release PR will fight the conventions gate."
            },
            "pre_release_gate": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "The repo's pre-release gate: commands /acs:release runs verbatim, in order, from the checkout root before a fresh cut edits anything. The first non-zero exit fails the run before the version bump; every command must exit 0 for the cut to proceed. Omit it and the skill says the repo declares no gate and proceeds \u2014 the honest answer, since the gate is repo-specific and this skill ships to consumer repos with no evals/ directory at all."
            },
            "publish_driver": {
              "description": "Documentary only \u2014 names the CI job that performs the privileged tag+publish step. release_notes.py validates but does not act on this field; the skill never tags or publishes itself regardless of its value (ADR 0052).",
              "type": "object",
              "properties": {
                "workflow": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Repo-relative path to the CI workflow file, e.g. '.github/workflows/release.yml'."
                },
                "trigger_paths": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "Paths whose change on base_branch fires the workflow."
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": true
}
