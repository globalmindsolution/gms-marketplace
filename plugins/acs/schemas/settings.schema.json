{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/globalmindsolution/gms-marketplace/plugins/acs/schemas/settings.schema.json",
  "title": "acs settings.json",
  "description": "Optional acs configuration: every key has a default, so a repo needs no file at all (ADR-0105); /acs:setup writes the conventions a team changes. Scopes: ~/.acs/settings.json (user), <repo>/.acs/settings.json (project, committed), <repo>/.acs/settings.local.json (machine-specific, gitignored). Per-key merge: local -> project -> user. Unknown keys are tolerated for forward compatibility. No key locates a document or the workspace: skills find the repo's docs through CLAUDE.md and the repo itself, and the workspace is always <main-checkout>/.acs/state-machine (ADR-0102).",
  "type": "object",
  "properties": {
    "ticket_prefix": {
      "description": "Per-repo prefix for ticket ids (<prefix>-<n>). Optional: a repo that sets none uses ACS (ADR-0105).",
      "default": "ACS",
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*$"
    },
    "merge_strategy": {
      "enum": [
        "squash",
        "merge",
        "rebase"
      ],
      "default": "squash"
    },
    "tests": {
      "description": "Test configuration. `coverage` is the target for the /code TDD cycle and the CI tests gate (missing it is a hard fail; default 90). Every other key is a named suite: `unit` is the CI tests+coverage gate scaffolded by /acs:setup (its command MUST run the suite and FAIL on a coverage shortfall - delegate to the tool, e.g. 'pytest --cov --cov-fail-under=$ACS_COVERAGE'; acs exports ACS_COVERAGE into the env), `e2e` is the end-to-end suite (unset = the repo has none), and any other name (smoke, api, nightly...) is run by /acs:run-e2e-tests. CI reads the committed project settings.json; the runner has no acs install.",
      "type": "object",
      "properties": {
        "coverage": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100,
          "default": 90
        }
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1,
            "description": "Command that runs the suite, e.g. 'npm run test:e2e'."
          },
          "setup": {
            "type": "string",
            "minLength": 1,
            "description": "Optional environment bring-up, e.g. 'docker compose up -d --wait'."
          },
          "teardown": {
            "type": "string",
            "minLength": 1,
            "description": "Optional environment teardown; always run after the suite, pass or fail."
          }
        },
        "additionalProperties": true
      }
    },
    "evals": {
      "description": "Behavioral-eval harness configuration (read by evals/<plugin>/, never by the hook layer). forge_repo names the dedicated, NEVER-PRODUCTION, org-owned GitHub repo the forge tier runs the real delivery pipeline against; the harness additionally requires the target's name to match ^acs-eval(-[a-z0-9][a-z0-9-]*)?$ and the target checkout to contain a committed .acs-eval-target marker file. ACS_FORGE_REPO overrides this value.",
      "type": "object",
      "properties": {
        "forge_repo": {
          "description": "owner/name of the forge-tier eval target repo. MUST NOT be a production repo.",
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
        }
      },
      "additionalProperties": true
    },
    "workflow": {
      "description": "Orchestration settings. The pipeline ORDER itself lives in workflows/ship.yaml (the plugin default, or the consumer override at .acs/workflows/ship.yaml, which replaces it wholesale). advisories: when a hooked skill runs out of that declared order (its `needs` are not satisfied for the ticket), its pre-hook prints one stderr advisory naming the position and continues; false silences the line. Never a refusal either way \u2014 skills keep only input and safety checks.",
      "type": "object",
      "properties": {
        "advisories": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": true
    },
    "models": {
      "description": "Model and effort per subagent, keyed skill -> role. An absent skill, role or field, or the value 'inherit', inherits the parent session's value. A model is an alias, a full model id or 'inherit'. Written in full by `acs settings scaffold`.",
