{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/globalmindsolution/gms-marketplace/plugins/acs/schemas/clarifications.schema.json",
  "title": "acs clarifications.json",
  "description": "Requirement-clarification ledger: per ticket at <workspace>/<repo>/<ticket-id>/clarifications.json, or, for a run with no ticket (ADR-0128), per run at <workspace>/<repo>/runs/<run-id>/clarifications.json — the single source of truth for every ambiguity resolved (or assumed) during the pipeline. Append-only via clarify.py; coordinators read it before asking the user anything (re-asking an answered question is a defect).",
  "type": "object",
  "required": ["clarifications"],
  "properties": {
    "ticket_id": {"oneOf": [{"type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]+$"}, {"type": "null"}]},
    "run_id": {"description": "The run whose ledger this is, when it has no ticket.", "type": "string"},
    "clarifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "skill", "question", "status", "asked_at"],
        "properties": {
          "id": {"type": "string", "pattern": "^C-[0-9]+$"},
          "skill": {
            "enum": ["analyze-ticket", "code", "code-complex", "code-small", "code-standard", "code-trivial", "create-api-contract", "create-architecture", "create-design", "create-docs", "create-e2e-tests", "create-impl-plan", "create-pr", "create-prd", "create-project", "create-requirements", "create-tech-design", "create-test-docs", "create-ticket", "docs-sync", "handoff", "install-hooks", "merge-pr", "metrics", "project", "release", "run-e2e-tests", "setup", "ship", "standardize-project", "test", "update", "usage", "create-spec"]
          },
          "question": {"type": "string", "minLength": 1},
          "answer": {"oneOf": [{"type": "string"}, {"type": "null"}]},
          "source": {
            "description": "user = the user decided; assumption = recorded default pending user confirmation (requires rationale).",
            "oneOf": [{"enum": ["user", "assumption"]}, {"type": "null"}]
          },
          "rationale": {
            "description": "Why an assumption was needed and why this default; required when source is assumption.",
            "oneOf": [{"type": "string"}, {"type": "null"}]
          },
          "status": {"enum": ["open", "answered", "assumed", "withdrawn"]},
          "asked_at": {"type": "string", "format": "date-time"},
          "answered_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
