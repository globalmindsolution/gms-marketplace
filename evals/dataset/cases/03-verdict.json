        "exit_code": 0,
        "stdout_json_subset": {
          "ok": true,
          "passed": false,
          "claimed_passed": false,
          "blocking": 1,
          "errors": []
        }
      },
      "severity": "critical"
    },
    {
      "id": "VERDICT-004",
      "title": "the invariant binds in both directions: passed=false with no blocking finding is refused",
      "note": "A verifier cannot fail a run without saying what blocks it \u2014 otherwise the review loop has nothing to converge on.",
      "files": [
        {
          "base": "ticket",
          "path": "phases/code/iter-1-verdict.json",
          "fixture": "verdict/lying-fail.json"
