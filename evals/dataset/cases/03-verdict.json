{
  "group": "verifier verdict",
  "description": "MAR-527 made `verifier_passed` a field the kernel READS from a verdict document the verifier WRITES, instead of a claim the coordinator relayed. The invariant that makes it a verdict rather than a self-report \u2014 `passed` must equal 'no blocking finding' \u2014 is not expressible in JSON Schema and is enforced by acs_lib.verdict.validate_verdict, which is what the SubagentStop hook runs. These cases pin that meaning, in both directions, plus the completeness and freshness rules that stop a stale or partial verdict from opening the create-pr gate.",
  "surface": "acs verdict",
  "covers": [
    "MAR-527"
  ],
  "profile": "ticketed",
  "cases": [
    {
      "id": "VERDICT-001",
      "title": "an honest pass over all 15 base dimensions is accepted",
      "files": [
        {
          "base": "ticket",
          "path": "phases/code/iter-1-verdict.json",
          "fixture": "verdict/honest-pass.json"
        }
      ],
      "invoke": {
        "argv": [
          "verdict",
          "show",
          "--ticket",
          "TKT-1",
          "--skill",
          "code",
          "--iteration",
          "1"
        ]
      },
      "expect": {
        "exit_code": 0,
        "stdout_json_subset": {
          "ok": true,
          "passed": true,
          "claimed_passed": true,
          "blocking": 0,
          "errors": [],
          "ticket_id": "TKT-1"
        }
      }
    },
    {
      "id": "VERDICT-002",
      "title": "HEADLINE: passed=true alongside a blocking finding is refused",
      "note": "The defect MAR-527 exists to remove. A verifier that claims to pass while carrying a blocking finding must not be able to open the create-pr gate.",
      "files": [
        {
          "base": "ticket",
          "path": "phases/code/iter-1-verdict.json",
          "fixture": "verdict/lying-pass.json"
        }
      ],
      "invoke": {
        "argv": [
          "verdict",
          "show",
          "--ticket",
          "TKT-1",
          "--skill",
          "code",
          "--iteration",
          "1"
        ]
      },
      "expect": {
        "exit_code": 2,
        "stderr_contains": [
          "passed is true but the verdict carries 1 blocking finding(s) (Tests)",
          "`passed` is derived from the findings, not asserted alongside them"
        ]
      },
      "severity": "critical"
    },
    {
      "id": "VERDICT-003",
      "title": "an honest fail \u2014 passed=false with the blocking finding recorded \u2014 is accepted",
      "files": [
        {
          "base": "ticket",
