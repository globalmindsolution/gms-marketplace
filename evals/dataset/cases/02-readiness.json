          "ready": true,
          "behind": false,
          "failed": [],
          "dimensions": {
            "approvals": "pass",
            "ci": "pass",
            "conflicts": "pass",
            "protections": "pass"
          },
          "stop_reason": null
        }
      }
    },
    {
      "id": "READY-005",
      "title": "a required check with neither status nor state is pending, not passing",
      "invoke": {
        "argv": [
