{
  "group": "merge readiness",
  "description": "merge-pr's four readiness dimensions and one verdict, replayed from recorded `gh pr view` documents. MAR-524 turned this from prose in merge-pr/SKILL.md into a pure function, so every verdict here is reproducible offline and reviewable. The fixtures live in dataset/fixtures/readiness/.",
  "surface": "acs readiness",
  "covers": [
    "MAR-524"
  ],
  "profile": "bare",
  "cases": [
    {
      "id": "READY-001",
      "title": "a clean, approved, green PR is ready to merge",
      "invoke": {
        "argv": [
          "readiness",
          "--from",
          "{{fixture:readiness/ready.json}}"
        ]
      },
      "expect": {
        "exit_code": 0,
        "stdout_json_subset": {
          "ok": true,
          "verdict": "ready",
          "ready": true,
          "behind": false,
          "failed": [],
          "dimensions": {
            "approvals": "pass",
            "ci": "pass",
            "conflicts": "pass",
            "protections": "pass"
          },
          "stop_reason": null
        }
      }
    },
    {
      "id": "READY-002",
      "title": "a failing REQUIRED check blocks, and the reason names the check",
      "invoke": {
        "argv": [
          "readiness",
          "--from",
          "{{fixture:readiness/ci-required-failing.json}}"
        ]
      },
      "expect": {
        "exit_code": 0,
        "stdout_json_subset": {
          "ok": true,
          "verdict": "blocked",
          "ready": false,
          "behind": false,
          "failed": [
            "ci"
          ],
          "dimensions": {
            "approvals": "pass",
            "ci": "fail: required check(s) failing: build",
            "conflicts": "pass",
            "protections": "pass"
          },
          "stop_reason": "readiness failed: ci required check(s) failing: build"
        }
      }
    },
    {
      "id": "READY-003",
      "title": "a required check still running blocks \u2014 pending is not passing",
      "invoke": {
        "argv": [
          "readiness",
          "--from",
          "{{fixture:readiness/ci-required-pending.json}}"
        ]
      },
      "expect": {
        "exit_code": 0,
        "stdout_json_subset": {
          "ok": true,
          "verdict": "blocked",
          "ready": false,
          "behind": false,
          "failed": [
            "ci"
          ],
          "dimensions": {
            "approvals": "pass",
            "ci": "fail: required check(s) still running: build",
            "conflicts": "pass",
            "protections": "pass"
          },
          "stop_reason": "readiness failed: ci required check(s) still running: build"
        }
      },
      "severity": "critical"
    },
    {
      "id": "READY-004",
      "title": "a failing OPTIONAL check does not block the merge",
