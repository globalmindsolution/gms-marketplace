          "dimensions": {
            "approvals": "pass",
            "ci": "fail: required check(s) still running: mystery",
            "conflicts": "pass",
            "protections": "pass"
          },
          "stop_reason": "readiness failed: ci required check(s) still running: mystery"
        }
      },
      "severity": "critical"
    },
    {
      "id": "READY-006",
