          "dimensions": {
            "approvals": "fail: no approving review (this repo requires none, but an agent-invoked merge must carry one \u2014 ADR-0028)",
            "ci": "pass",
            "conflicts": "pass",
            "protections": "pass"
          },
          "stop_reason": "readiness failed: approvals no approving review (this repo requires none, but an agent-invoked merge must carry one \u2014 ADR-0028)"
